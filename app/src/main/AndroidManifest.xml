<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 날씨(선택 기능)와 음악 앱이 제공하는 https 커버 이미지 로딩에만 사용. 시계는 오프라인으로 작동 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 내부 음악 플레이어 (Media3 MediaSessionService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 선택 기능: 충전 연결 감지 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 선택 기능: 충전 시 자동 실행(사용자가 '다른 앱 위에 표시'를 직접 허용한 경우에만) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 선택 기능: 일정 위젯 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 재생 중인 음악 앱의 이름을 표시하기 위해 미디어 앱만 조회 (Android 11+ 패키지 공개 범위) -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="androidx.media3.session.MediaSessionService" />
        </intent>
        <!-- 삼성 '모드 및 루틴' 바로가기 -->
        <package android:name="com.samsung.android.app.routines" />
    </queries>

    <application
        android:name=".StandByApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StandBy"
        tools:targetApi="35">

        <!-- 홈 / 설정 -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.StandBy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- StandBy 전체 화면. 별도 런처 아이콘을 두어 삼성 '모드 및 루틴'의 '앱 실행' 동작에서 바로 고를 수 있게 함 -->
        <activity
            android:name=".ui.standby.StandByActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:excludeFromRecents="false"
            android:exported="true"
            android:icon="@mipmap/ic_standby"
            android:label="@string/standby_launcher_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:taskAffinity="com.galaxy.standbypro.standby"
            android:theme="@style/Theme.StandBy.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.galaxy.standbypro.action.START_STANDBY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 시스템 화면 보호기 (공식 DreamService) -->
        <service
            android:name=".dream.StandByDreamService"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream_info" />
        </service>

        <!-- 다른 음악 앱의 MediaSession 읽기용 (사용자가 '알림 접근'을 직접 허용해야 함) -->
        <service
            android:name=".music.MediaNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 내부 음악 플레이어 -->
        <service
            android:name=".music.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- 선택 기능: 충전 연결 + 가로 놓기 감지 -->
        <service
            android:name=".system.ChargingWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects charger connection and landscape placement to show a user-enabled bedside clock (StandBy)." />
        </service>

        <receiver
            android:name=".system.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
